// Cloudflare Workers 静态资源配置（Workers 构建 / npx wrangler deploy 会读这个文件）
// 作用：明确 assets.directory = "./"，修复"无法检测到包含项目静态文件目录"的报错
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zyyyds-asd",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  }
}
